# 可选的 systemd 单元模板。当前发布用各站点目录里的 start.sh --daemon，不会安装本文件。
# 每个网站的目录和端口不同。若要开机自启，复制后把 SITE 和端口改成该站的实际值。
#
#   cp rxweb.service /etc/systemd/system/rxweb-SITE.service
#   systemctl daemon-reload
#   systemctl enable --now rxweb-SITE

[Unit]
Description=RxWeb site
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/SITE/backend
Environment=PATH=/www/wwwroot/SITE/.venv/bin
ExecStart=/www/wwwroot/SITE/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
