# 复制为 deploy.env 后再填写。deploy.env 已在 .gitignore 中，不要提交密码。
#
#   copy deploy.env.example deploy.env
#
# 本机执行：
#   Windows:  pwsh -File .\deploy.ps1
#   Linux:    bash deploy.sh

DEPLOY_HOST=47.97.245.103
DEPLOY_USER=root
DEPLOY_PATH=/www/wwwroot/RxWeb
DEPLOY_SSH_PORT=22
APP_PORT=8001

# 有 SSH 密钥时可留空。没有密钥时填写登录密码：
# DEPLOY_PASS=

# 可选：重置密码邮件。不填时，重置链接会显示在页面上并写入操作日志。
# PUBLIC_BASE_URL=http://47.97.245.103:8001
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
