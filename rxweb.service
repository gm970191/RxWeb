# RxWeb systemd 单元文件（可选，给 Ubuntu 开机自启用）
#
# 使用前请先用 start.sh 成功启动过一次，确保已有：
#   /www/wwwroot/RxWeb/.venv
#   /www/wwwroot/RxWeb/frontend/dist
#
# 安装：
#   cp /www/wwwroot/RxWeb/rxweb.service /etc/systemd/system/rxweb.service
#   systemctl daemon-reload
#   systemctl enable --now rxweb
#
# 若网站不在 /www/wwwroot/RxWeb，或运行用户不是 www，请改下面几项。

[Unit]
Description=RxWeb official website
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/RxWeb/backend
Environment=PATH=/www/wwwroot/RxWeb/.venv/bin
ExecStart=/www/wwwroot/RxWeb/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
