# 忽略 node_modules 目录
node_modules/

# 忽略日志文件
*.log

# 忽略环境变量文件
.env
.env.*
deploy.env
runtime.env

# 忽略打包输出目录
/dist
/build
frontend/dist/

# 忽略本机/服务器虚拟环境（Windows 的 venv 不能拿到 Linux 上用）
backend/venv/
.venv/

# 忽略本地打包产物
RxWeb-deploy.zip
.deploy-stage/

# 忽略运行时文件
logs/
rxweb.pid
rxweb-dev-backend.pid

# 忽略临时文件
*.tmp
*.temp
__pycache__/
*.pyc